# Variables de las Edge Functions (fase 4). Ver docs/WHATSAPP.md.
# Local: copiar a supabase/functions/.env (no se sube al repo) y correr
#   pnpm exec supabase functions serve --no-verify-jwt --env-file supabase/functions/.env
# Nube: supabase secrets set NOMBRE=valor ...

# consola (desarrollo: registra en el log y marca enviado) | whatsapp (API oficial de Meta)
MENSAJES_PROVEEDOR=consola
# Secreto con el que pg_cron llama a enviar-mensajes (el mismo valor va en Vault como "mensajes_secreto")
MENSAJES_SECRETO=cambiar-por-un-secreto-largo
# URL pública de la app (para los links {link} de los mensajes)
APP_URL=http://localhost:5180
# Cuántos mensajes toma por vuelta (opcional)
# MENSAJES_LOTE=50

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=cambiar-por-otro-secreto
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v26.0
# WHATSAPP_IDIOMA=es_AR
# WHATSAPP_PLANTILLA_CODIGO=codigo_ingreso
# WHATSAPP_PLANTILLA_CONFIRMACION=turno_confirmacion
# WHATSAPP_PLANTILLA_RECORDATORIO24=turno_recordatorio_24
# WHATSAPP_PLANTILLA_RECORDATORIO2=turno_recordatorio_2
# WHATSAPP_PLANTILLA_CANCELACION=turno_cancelado
# WHATSAPP_PLANTILLA_RECUPERAR=cliente_recuperar

# Web Push (claves VAPID; la pública también va en la app como VITE_VAPID_PUBLIC_KEY)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@sawatek.com
# PUSH_HOSTS=fcm.googleapis.com,android.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com

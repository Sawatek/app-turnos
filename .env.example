# En Vercel, la integración con Supabase carga estas variables sola (NEXT_PUBLIC_SUPABASE_URL y
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY). Para desarrollo local, copiá este archivo como .env.local y
# completalo con Project Settings → API de Supabase (o `vercel env pull .env.local`).
# Son claves públicas por diseño: la protección la dan las reglas (RLS).
# Sin estas variables la app funciona igual, pero las demos se guardan solo en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Dominio público del sitio, sin barra al final (ej. https://confirmo.com.ar). En Vercel: solo en Production.
# Con esta variable el build agrega canonical, og:url, imágenes para compartir con URL absoluta, sitemap.xml y la línea
# Sitemap de robots.txt. Sin ella todo funciona igual (imágenes relativas, sin sitemap). En local dejala vacía.
VITE_URL_SITIO=
